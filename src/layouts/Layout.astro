---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Dignity Amenaghawon</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased flex flex-col min-h-screen">
    <header class="bg-white border-b border-slate-200 py-6 relative">
      <div class="container mx-auto px-4 max-w-5xl flex justify-between items-center">
        <a href="/" class="text-xl font-bold tracking-tight text-slate-900">Dignity Amenaghawon</a>
        
        <!-- Desktop Menu -->
        <nav class="hidden md:flex space-x-8 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-[#0F766E] transition">Home</a>
          <a href="/about" class="hover:text-[#0F766E] transition">About</a>
          <a href="/leadership" class="hover:text-[#0F766E] transition">Leadership</a>
          <a href="/publications" class="hover:text-[#0F766E] transition">Publications</a>
          <a href="/contact" class="hover:text-[#0F766E] transition">Contact</a>
        </nav>

        <!-- Mobile Menu Button -->
        <button id="personal-mobile-btn" class="md:hidden text-slate-900 focus:outline-none">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div id="personal-mobile-menu" class="hidden md:hidden bg-white border-t border-slate-200">
        <nav class="flex flex-col px-4 py-2 space-y-2 text-sm font-medium text-slate-600">
          <a href="/" class="block py-2 hover:text-[#0F766E] transition">Home</a>
          <a href="/about" class="block py-2 hover:text-[#0F766E] transition">About</a>
          <a href="/leadership" class="block py-2 hover:text-[#0F766E] transition">Leadership</a>
          <a href="/publications" class="block py-2 hover:text-[#0F766E] transition">Publications</a>
          <a href="/contact" class="block py-2 hover:text-[#0F766E] transition">Contact</a>
        </nav>
      </div>
    </header>
    <main class="container mx-auto px-4 py-12 max-w-5xl flex-grow">
      <slot />
    </main>
    <footer class="bg-slate-900 text-slate-300 py-8 mt-12">
      <div class="container mx-auto px-4 max-w-5xl text-center text-sm">
        <p>&copy; {new Date().getFullYear()} Dignity Amenaghawon. All rights reserved.</p>
        <p class="mt-2">
          <a href="https://dignifiedfuture.org" target="_blank" class="text-[#0F766E] hover:underline">Founder of Dignified Future Initiative &rarr;</a>
        </p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('personal-mobile-btn');
      const menu = document.getElementById('personal-mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
